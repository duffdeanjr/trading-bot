# .env.example -- copy to .env and fill in your real keys
# Never commit .env to version control

APCA_API_KEY_ID=your_paper_key_here
APCA_API_SECRET_KEY=your_paper_secret_here
IS_PAPER=true

# -- watchlist --
# WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,SPY,QQQ,IWM
# WATCHLIST_ALPACA=My Watchlist        # fetch from Alpaca watchlist by name
# CRYPTO_WATCHLIST=BTC/USD,ETH/USD

# -- dry run (log orders without submitting) --
# DRY_RUN=true

# -- timing --
# TICK_INTERVAL=5
# OVERNIGHT_SLEEP=60

# -- data --
# DATA_FEED=iex

# -- options --
# OPTIONS_LEVEL=3
# OPTIONS_ENABLED=true

# -- risk --
# MAX_POSITION_SIZE=10000
# MAX_PORTFOLIO_PCT=0.15
# MARGIN_MIN_EQUITY=2000

# -- signal thresholds --
# RSI_OVERSOLD=35
# RSI_OVERBOUGHT=70
# RISK_FREE_RATE=0.05

# -- portfolio heat / VIX --
# VIX_NORMAL=20
# VIX_CAUTION=25
# VIX_HIGH=35
# VIX_EXTREME=45
# HEAT_MAX=0.80
# HEAT_WARN=0.60

# -- data retention --
# RETENTION_DAYS=90

# -- dashboard --
# DASHBOARD_PORT=5050

# -- Claude API (for plan reviewer agent) --
# ANTHROPIC_API_KEY=sk-ant-your-key-here
